{
  "name": "@restorecommerce/scheduling-srv",
  "version": "1.4.2",
  "description": "Restorecommerce job scheduling microservice",
  "main": "./dist/start.js",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/scheduling-srv.git"
  },
  "license": "MIT",
  "keywords": [
    "restore",
    "commerce",
    "microservice",
    "job",
    "scheduling"
  ],
  "type": "module",
  "dependencies": {
    "@bull-board/api": "6.14.1",
    "@bull-board/express": "6.14.1",
    "@bull-board/koa": "6.14.1",
    "@restorecommerce/acs-client": "3.2.2",
    "@restorecommerce/chassis-srv": "1.9.2",
    "@restorecommerce/kafka-client": "1.4.2",
    "@restorecommerce/logger": "1.4.2",
    "@restorecommerce/rc-grpc-clients": "5.2.2",
    "@restorecommerce/scs-jobs": "0.3.2",
    "@restorecommerce/service-config": "1.2.2",
    "bullmq": "5.63.0",
    "cron-parser": "5.7.0",
    "express": "5.2.1",
    "lodash-es": "4.18.1",
    "redis": "4.7.1"
  },
  "devDependencies": {
    "@alenon/grpc-mock-server": "^3.2.9",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@grpc/proto-loader": "^0.8.1",
    "@restorecommerce/dev": "^0.3.1",
    "@restorecommerce/grpc-client": "^2.3.2",
    "@semantic-release-plus/docker": "^3.1.3",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/nconf": "^0.10.7",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "should": "^13.2.3"
  },
  "overrides": {
    "redis": "4.7.1",
    "@platformatic/kafka": "2.3.0"
  },
  "scripts": {
    "start": "node ./dist/start.cjs",
    "dev": "cross-env NODE_ENV=development node ./dist/start.cjs",
    "pretest": "npm-run-all lint",
    "test": "vitest run",
    "lint": "eslint src --fix --ignore-pattern **/*.d.ts",
    "build:es": "node esbuild.mjs",
    "build:clean": "rimraf ./dist ./lib ./coverage",
    "copy:bullboard-ui-static": "npx copyfiles -u 1 \"./node_modules/@bull-board/ui/dist/**/*\" ./dist/",
    "copy:kafka-native": "cp ./node_modules/@platformatic/wasm-utils/dist/native.wasm ./dist/",
    "prebuild": "npm-run-all lint build:clean",
    "build": "npm-run-all build:es",
    "postbuild": "npm-run-all copy:bullboard-ui-static copy:kafka-native",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\""
  },
  "engines": {
    "node": ">= 26"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/scheduling-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/scheduling-srv",
          "skipLogin": true
        }
      ]
    ]
  }
}
